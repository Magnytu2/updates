<?xml version="1.0" encoding="utf-8"?>
<!--
	SERVEUR DE MISE A JOUR — Tikus

	Publie a https://magnytu2.github.io/updates/pkg_tikus.xml
	Doit correspondre AU CARACTERE PRES a l'adresse inscrite sous
	<updateservers> dans le manifeste de l'extension.

	VERSION STABLE depuis le 27 aout 2026, avec tous les produits Joomanji.
	Aucun suffixe -rc : la balise <tag> dit `stable`, et elle doit dire la
	verite sur la version publiee.

	CE NUMERO NE RECULE JAMAIS. Joomla ordonne les versions : un client en
	2.6.2 ne verrait jamais une 2.5.3, et celui qui l'installerait reviendrait
	en arriere sans le savoir.

	2.6.2 ajoute l'archivage et la suppression d'une demande close, depuis la
	liste deroulante de sa carte. ATTENTION, cette serie porte une migration de
	base (2.6.0.sql) qui ajoute la colonne `archive_le`.
 -->
<updates>
	<update>
		<name>Tikus</name>
		<description>Tikus - tickets d'assistance pour Joomla : le composant, le module de site, l'alerte d'entete de l'administration et la tache de cloture automatique.</description>
		<element>pkg_tikus</element>
		<type>package</type>
		<client>site</client>
		<version>2.6.2</version>
		<downloads>
			<downloadurl type="full" format="zip">https://magnytu2.github.io/updates/pkg_tikus-2.6.2.zip</downloadurl>
		</downloads>
		<sha256>0179440fd83a909641edcddf4b5b41d8023beba3dc9aef0426aeff8c33c11b21</sha256>
		<tags>
			<tag>stable</tag>
		</tags>
		<maintainer>Joomanji</maintainer>
		<maintainerurl>https://joomanji.eu</maintainerurl>
		<infourl title="Tikus">https://joomanji.eu</infourl>
		<targetplatform name="joomla" version="6\.[0-9]+"/>
		<php_minimum>8.1</php_minimum>
	</update>
</updates>
