<?xml version="1.0" encoding="utf-8"?>
<!--
	SERVEUR DE MISE A JOUR, Iris (plugin seul, jusqu'a 2.1.1)

	Publie a https://magnytu2.github.io/updates/plg_system_iris.xml
	C'est l'adresse inscrite dans le manifeste du plugin seul 2.x.

	DEUX ANNONCES, choisies par Joomla selon sa version (targetplatform) :
	 - Joomla 6 : 3.0.031, qui livre le PAQUET pkg_iris. Joomla 6.1.3,
	   UpdateModel::install(), prend le type dans le zip telecharge : la mise a
	   jour du plugin installe le paquet. Le script du paquet retire ensuite
	   cette adresse ; le site ne suit plus que pkg_iris.xml.
	 - Joomla 4 et 5 : 2.1.1, derniere version du plugin seul. Ne pas retirer
	   plg_system_iris-2.1.1.zip du depot tant que ces sites existent.

	CE NUMERO NE RECULE JAMAIS.

	3.0.031 annonce le 29 septembre 2026.
-->
<updates>
	<update>
		<name>Iris</name>
		<description>Iris devient un paquet : mediatheque, galeries, pastilles d'utilisation des medias et conversion en WebP pour Joomla 6.</description>
		<element>iris</element>
		<type>plugin</type>
		<client>site</client>
		<folder>system</folder>
		<version>3.0.031</version>
		<downloads>
			<downloadurl type="full" format="zip">https://magnytu2.github.io/updates/pkg_iris-3.0.031.zip</downloadurl>
		</downloads>
		<sha256>569bedbaff3291842d393073f024ba165a6016e57100157cb01541dd84e611c3</sha256>
		<tags>
			<tag>stable</tag>
		</tags>
		<maintainer>Joomanji</maintainer>
		<maintainerurl>https://joomanji.eu</maintainerurl>
		<infourl title="Iris">https://joomanji.eu</infourl>
		<targetplatform name="joomla" version="6\.[0-9]+"/>
		<php_minimum>8.1</php_minimum>
	</update>
