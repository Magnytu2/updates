<?xml version="1.0" encoding="utf-8"?>
<!--
	SERVEUR DE MISE A JOUR : Oculus

	Publie a https://magnytu2.github.io/updates/mod_oculus.xml
	Doit correspondre AU CARACTERE PRES a l'adresse inscrite sous
	<updateservers> dans le manifeste de l'extension.

	2.1.0, le 27 aout 2026. Trois changements d'un coup :

	- Fin du suffixe -rc. Les numeros sont desormais des numeros stables.
	  version_compare place 2.1.0 au-dessus de 2.0.2-rc2 : rien ne recule.
	- Etiquette stable. Elle etait a rc, et c'est elle qui filtre, pas le
	  suffixe du numero : la Stabilite minimale de Joomla vaut Stable (4) par
	  defaut, rc vaut 3, donc un site au reglage d'origine ne voyait rien.
	- Le plugin client s'appelle desormais « oculusclient ». Il repond encore
	  a l'ancien nom « sitemonitor », le temps que le parc migre.

	2.1.1, le 27 aout 2026 : CORRECTIF. Le module masquait notre propre paquet
	de la colonne Extensions meme quand il portait une mise a jour en attente.
	Les sites du parc detectaient bien la nouvelle version, chacun la montrait
	dans son propre gestionnaire d'extensions, et le tableau de bord n'affichait
	rien. Le masquage ne s'applique plus qu'en l'absence de mise a jour.

	2.4.0, publie le 25 septembre 2026 (paquet en attente depuis le 8).
-->
<updates>
	<update>
		<name>Oculus</name>
		<description>Module d'administration Oculus : etat des sites Joomla surveilles.</description>
		<element>mod_oculus</element>
		<type>module</type>
		<client>administrator</client>
		<version>2.4.0</version>
		<downloads>
			<downloadurl type="full" format="zip">https://magnytu2.github.io/updates/mod_oculus-2.4.0.zip</downloadurl>
		</downloads>
		<sha256>627a03e32e6960f0bbc99ea4aaff62a2f0449ad1f2498c721c4dc339dae28309</sha256>
		<tags><tag>stable</tag></tags>
		<maintainer>Joomanji</maintainer>
		<maintainerurl>https://joomanji.eu</maintainerurl>
		<infourl title="Oculus">https://joomanji.eu</infourl>
		<targetplatform name="joomla" version="[456]\."/>
		<php_minimum>8.1</php_minimum>
	</update>
</updates>
