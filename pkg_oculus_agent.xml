<?xml version="1.0" encoding="utf-8"?>
<!--
	SERVEUR DE MISE A JOUR : Oculus Client

	Publie a https://magnytu2.github.io/updates/pkg_oculus_agent.xml
	Doit correspondre AU CARACTERE PRES a l'adresse inscrite sous
	<updateservers> dans le manifeste de l'extension.

	2.1.0, le 27 aout 2026 : fin du suffixe -rc, etiquette stable, plugin client
	renomme « oculusclient ». 2.1.1, meme jour : correctif de la reprise des
	reglages. NE PAS DEPLOYER LA 2.1.0.

	2.1.2, le 25 octobre 2026 : le bouclier .htaccess n'est plus annule a tort
	sur un site en maintenance (tekmad-aquanature) ni sur un site qui ne se
	joint pas lui-meme par son nom (bellefeuille). Etat de la page d'accueil
	compare avant et apres l'ecriture. Teste d'abord sur bellefeuille.joomanji.eu.

	POURQUOI CE FICHIER S'APPELLE « agent » ET PAS « client ». Le paquet installe
	sur les sites du parc porte l'identifiant technique pkg_oculus_agent, alors
	qu'il s'affiche « Oculus Client ». Joomla apparie une mise a jour sur
	l'identifiant, jamais sur le nom affiche. Les deux fichiers coexistent donc,
	pkg_oculus_agent.xml pour le parc, pkg_oculus_client.xml pour les rares sites
	equipes de l'autre paquet. Les publier ensemble.
-->
<updates>
	<update>
		<name>Oculus Client</name>
		<description>Paquet Oculus Client (client + passerelle maintenance), a installer sur chaque site surveille.</description>
		<element>pkg_oculus_agent</element>
		<type>package</type>
		<client>site</client>
		<version>2.1.2</version>
		<downloads>
			<downloadurl type="full" format="zip">https://magnytu2.github.io/updates/pkg_oculus_agent-2.1.2.zip</downloadurl>
		</downloads>
		<changelogurl>https://magnytu2.github.io/updates/pkg_oculus_agent-changelog.xml</changelogurl>
		<sha256>c8e68459e16dd5adef181a4085d101c3f7b71f76fc5ed72b21536bcada2e6379</sha256>
		<tags><tag>stable</tag></tags>
		<maintainer>Joomanji</maintainer>
		<maintainerurl>https://joomanji.eu</maintainerurl>
		<infourl title="Oculus Client">https://joomanji.eu</infourl>
		<targetplatform name="joomla" version="[456]\."/>
		<php_minimum>8.1</php_minimum>
	</update>
</updates>
