<?xml version="1.0" encoding="utf-8"?>
<!--
	SERVEUR DE MISE A JOUR — Oculus Client

	Publie a l'adresse https://magnytu2.github.io/updates/plg_ajax_sitemonitor.xml
	Cette adresse doit correspondre AU CARACTERE PRES a celle inscrite dans le
	manifeste de l'extension, sous <updateservers>. Une difference, meme un
	slash final, et Joomla ne cherche jamais de mise a jour — sans message.

	LA SOMME DE CONTROLE CHANGE A CHAQUE VERSION. Republier un zip sans refaire
	le hash casse la mise a jour pour tout le monde.

	LE NUMERO DE VERSION NE RECULE JAMAIS. Joomla ordonne les versions ; un
	client en 1.0.7 ne verrait pas une 1.0.0, et celui qui l'installerait
	reviendrait en arriere sans le savoir.
-->
<updates>
	<update>
		<name>Oculus Client</name>
		<description>Plugin client Oculus : point d'acces JSON en lecture seule, a installer sur chaque site surveille.</description>
		<element>sitemonitor</element>
		<type>plugin</type>
		<folder>ajax</folder>
		<client>site</client>
		<version>0.18.0</version>
		<downloads>
			<downloadurl type="full" format="zip">https://magnytu2.github.io/updates/plg_ajax_sitemonitor_v0.18.0.zip</downloadurl>
		</downloads>
		<sha256>e5264855929ca38045717f1fa404697fc057929651ee8924710518ee4ad39b79</sha256>
		<tags>
			<tag>stable</tag>
		</tags>
		<maintainer>Joomanji</maintainer>
		<maintainerurl>https://joomanji.eu</maintainerurl>
		<infourl title="Oculus Client">https://joomanji.eu</infourl>
		<targetplatform name="joomla" version="[456]\."/>
		<php_minimum>8.1</php_minimum>
	</update>
</updates>
