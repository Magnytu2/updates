<?xml version="1.0" encoding="utf-8"?>
<!--
	SERVEUR DE MISE A JOUR — Corpus

	Publie a https://magnytu2.github.io/updates/pkg_corpus.xml
	Doit correspondre AU CARACTERE PRES a l'adresse inscrite sous
	<updateservers> dans le manifeste de l'extension.

	PREMIERE VERSION STABLE, le 27 aout 2026. Corpus quitte le statut de
	candidat : 2.1.0, sans suffixe. La balise <tag> passe donc de `rc` a
	`stable` — elle doit dire la verite sur la version, sinon un site regle sur
	« stable uniquement » se verrait proposer un candidat, ou l'inverse.

	Un site regle sur « RC » voit aussi les versions stables : stable est plus
	haut que rc, pas plus bas. Aucun reglage n'est a changer chez le client.

	LA SUITE. Un numero ne recule jamais, et le suffixe ne departage que des
	parties chiffrees identiques. 2.1.0 est superieur a 2.0.43-rc2 parce que
	1 > 0 au deuxieme rang, pas a cause du suffixe. Si un candidat devait
	revenir, ce serait 2.1.1-rc1 — jamais 2.1.0-rc3, qui serait INFERIEUR au
	2.1.0 deja publie.

	NUMEROTATION REMISE A PLAT le 17 aout 2026 : les sept produits Joomanji
	etaient partis de 2.0.0-rc2. Pourquoi 2.0.0 et non 1.0.0 : 1.0.0-rc2 est
	INFERIEUR a 1.4.34-rc1 (Astus) et a 1.8.0-rc1 (Iris) — ces installations
	n'auraient plus rien vu.
-->
<updates>
	<update>
		<name>Corpus</name>
		<description>Paquet Corpus : le template Joomla 6 a grille de douze colonnes, accessible RGAA 4.1, et son plugin systeme.</description>
		<element>pkg_corpus</element>
		<type>package</type>
		<client>site</client>
		<version>2.1.0</version>
		<downloads>
			<downloadurl type="full" format="zip">https://magnytu2.github.io/updates/pkg_corpus-2.1.0.zip</downloadurl>
		</downloads>
		<sha256>e385d4cd9280db93c8dbdc03cfeae3e50d6ec516ef34cc31466d32e297cea49e</sha256>
		<tags>
			<tag>stable</tag>
		</tags>
		<maintainer>Joomanji</maintainer>
		<maintainerurl>https://joomanji.eu</maintainerurl>
		<infourl title="Corpus">https://joomanji.eu</infourl>
		<targetplatform name="joomla" version="6\.[0-9]+"/>
		<php_minimum>8.1</php_minimum>
	</update>
</updates>
